BOT_TOKEN=         # from @BotFather
DB_URL=            # postgresql://user:pass@host:5432/postgres (from Supabase Settings → Database → URI)
GROUP_ID=          # Telegram group chat ID (negative number, e.g. -1001234567890)
ADMIN_ID=          # Your Telegram user ID (integer)
CRON_SECRET=       # Any random string, e.g. openssl rand -hex 16
DASH_URL=          # Streamlit dashboard URL (set after deploy, optional)
YANDEX_API_KEY=          # Yandex Cloud → IAM → Service Accounts → API Keys
YANDEX_FOLDER_ID=        # Yandex Cloud → folder overview page
ANTHROPIC_API_KEY=       # console.anthropic.com → API Keys (for local leha_predict.py)
